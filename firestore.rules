rules_version = '2';

// 🔒 Firestore 보안 규칙
// 각 플레이어는 자기 계정의 저장 기록(saves/{자기 id})만 읽고 쓸 수 있다.
// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 붙여 넣고 "게시"한다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['save', 'version', 'updatedAt'])
        && request.resource.data.save is map;
    }
  }
}
